{
  "name": "Twilio Voice Assistant",
  "version": "1.11.0",
  "slug": "twilio_voice_assistant",
  "description": "Twilio Conversation Relay app with caller identity via HA Extended User Management, spoken self-declaration and PIN verification for unrecognized callers, ElevenLabs voice support, and an optional conversation_agent_id for routing calls to any HA conversation agent. Leave conversation_agent_id blank to use the elspeth_local per-caller identity bridge if installed -- selecting an agent here routes through HA's generic, identity-less conversation API instead.",
  "arch": [
    "amd64",
    "aarch64"
  ],
  "startup": "services",
  "boot": "auto",
  "ports": {
    "8000/tcp": 8000
  },
  "ports_description": {
    "8000/tcp": "FastAPI webhook server"
  },
  "options": {
    "twilio_account_sid": "",
    "twilio_auth_token": "",
    "public_base_url": "",
    "conversation_agent_id": "",
    "assistant_name": "",
    "conversation_relay_tts_provider": "ElevenLabs",
    "conversation_relay_voice": "",
    "conversation_relay_transcription_provider": "Deepgram",
    "conversation_relay_language": "en-US",
    "conversation_relay_eot_threshold": 0.8,
    "allow_unsigned_twilio_requests_for_dev": false,
    "debug": false
  },
  "schema": {
    "twilio_account_sid": "str",
    "twilio_auth_token": "password",
    "public_base_url": "str",
    "conversation_agent_id": "str?",
    "assistant_name": "str?",
    "conversation_relay_tts_provider": "list(ElevenLabs|Google|Amazon)?",
    "conversation_relay_voice": "str?",
    "conversation_relay_transcription_provider": "str?",
    "conversation_relay_language": "str?",
    "conversation_relay_eot_threshold": "float(0.5,0.9)?",
    "allow_unsigned_twilio_requests_for_dev": "bool?",
    "debug": "bool?"
  },
  "homeassistant_api": true,
  "hassio_api": true,
  "hassio_role": "default",
  "map": [
    "addon_config:rw"
  ]
}
